# Copy to .env and edit:  cp .env.example .env
# Never commit a real .env file. It is in .gitignore.
# Every service reads the same names; each one uses only what it needs.

# --- Where the other services are ---------------------------------------------
# Development: all on localhost. In Docker or Kubernetes use the service names, e.g. http://menu:8001
MENU_URL=http://localhost:8001
ORDERS_URL=http://localhost:8002
PAYMENTS_URL=http://localhost:8003
NOTIFICATIONS_URL=http://localhost:8004
# Seconds one service waits for another before it gives up (payments waits at least 5, orders at least 10 from the gateway).
DOWNSTREAM_TIMEOUT=2

# --- Orders only -----------------------------------------------------------------
# Empty = orders are kept in memory and lost on restart. Set it to keep them:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
MAX_ITEMS_PER_ORDER=20

# --- Common ------------------------------------------------------------------------
# Reported by /healthz, /metrics and the logs. Your pipeline should set it to the image tag.
APP_VERSION=0.1.0
# debug | info | warn | error
LOG_LEVEL=info
# json (one object per line, for log pipelines) or text (readable while developing)
LOG_FORMAT=json
# Port a service listens on (default: gateway 8000, menu 8001, orders 8002, payments 8003, notifications 8004)
# PORT=8000

# --- Tracing (OpenTelemetry) ---------------------------------------------------------
# Where to send spans, e.g. an OpenTelemetry Collector or Jaeger: http://localhost:4318
# Empty = spans are created but not exported (trace ids still appear in the logs).
OTEL_EXPORTER_OTLP_ENDPOINT=
# true = also print every span to stdout (noisy, useful to see what a trace contains)
OTEL_TRACES_CONSOLE=false

# --- Failure injection (monitoring exercises) ------------------------------------------
# true = PUT /chaos can make a service slow or flaky on purpose. Never enable in production.
CHAOS_ENABLED=false
